{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/nezuko-transparent.png",
    "width": 38,
    "printRemaining": false,
    "position": "left",
    "padding": {"right": 2}
  },
  "display": {
    "separator": "",
    "key": {"width": 0}
  },
  "modules": [
    {
      "type": "command",
      "key": "\u001b[2K",
      "text": "python3 ~/.config/fastfetch/nezuko-panel.py"
    }
  ]
}
