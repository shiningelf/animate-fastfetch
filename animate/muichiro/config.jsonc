{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/animate/muichiro/muichiro.png",
    "width": 30,
    "printRemaining": false,
    "position": "left",
    "padding": {"right": 2}
  },
  "display": {"separator": "", "key": {"width": 0}},
  "modules": [
    {"type": "command", "key": "\u001b[2K", "text": "python3 ~/.config/fastfetch/animate/muichiro/mist-panel.py"}
  ]
}
