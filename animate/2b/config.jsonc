{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 14
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;220;220;220m╭─ POD 042 // SCAN COMPLETE ─────────────────────────╮\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;150;150;150m│ TARGET: LOCAL MACHINE          SIGNAL: STABLE     │\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;220;220;220m╰────────────────────────────────────────────────────╯\u001b[0m"
    },
    {"type": "os", "key": "IDENTITY"},
    {"type": "kernel", "key": "SYSTEM"},
    {"type": "de", "key": "INTERFACE"},
    {"type": "shell", "key": "SHELL"},
    {"type": "uptime", "key": "UPTIME"},
    {"type": "cpu", "key": "PROCESSOR"},
    {"type": "memory", "key": "MEMORY"},
    {"type": "disk", "key": "STORAGE", "folders": "/"},
    {"type": "localip", "key": "NETWORK"},
    {
      "type": "custom",
      "format": "\u001b[38;2;220;220;220mPOD LINK: ONLINE  //  GLORY TO MANKIND\u001b[0m"
    }
  ]
}
